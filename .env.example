# YouVersion Platform API — https://platform.youversion.com/
YVP_APP_KEY=

# Gloo AI Studio API — https://studio.ai.gloo.com/  (OAuth2 client credentials)
# Optional until Phase 2 — reflection degrades gracefully if missing
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
# GLOO_TOKEN_URL=            # optional; defaults to Gloo auth endpoint (verify in cookbook)

# GhanaNLP Khaya API — https://translation.ghananlp.org/  (Twi ASR + TTS)
KHAYA_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=Dawuro
# Public site URL — REQUIRED in production. Used for the receive links that
# travel inside WhatsApp messages (/v/{lang}/{usfm}), the link preview OG
# images, and the URL printed on shared PNG cards. Set on Vercel.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
